#include <windows.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/mira.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @APP_VERSION_COMMAS@,0
 PRODUCTVERSION @APP_VERSION_COMMAS@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "@APP_NAME@ music companion"
   VALUE "ProductName", "@APP_NAME@"
   VALUE "ProductVersion", "@APP_VERSION@"
   VALUE "FileVersion", "@APP_VERSION@"
   VALUE "LegalCopyright", "MIT - Mira contributors"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
